# ======================================================================
# TEMPLATE FOR SOLPS-ITER 

# ======================================================================
# SIMULATION INFO SECTION
# ======================================================================

RUN_ID = solps
TOKAMAK_ID = D3D
SHOT_NUMBER = 183244
TIME_ID = 03100

SIM_NAME = ${RUN_ID}

OUTPUT_PREFIX = 
LOG_FILE = run.log
LOG_LEVEL = DEBUG

INPUT_DIR_SIM = ${PWD}/input
SIM_ROOT = ${PWD}/RUN

RUN_COMMENT = d3d solps-iter analysis
TAG = 

SIMULATION_MODE = NORMAL
RESTART_TIME =
RESTART_ROOT = ${SIM_ROOT}

# ======================================================================
# PLASMA STATE SECTION
# ======================================================================

STATE_WORK_DIR = ${SIM_ROOT}/work/plasma_state

CURRENT_STATE = b2fstate
CURRENT_GMTRY = b2fgmtry
CURRENT_RATES = b2frates
CURRENT_PARDF = b2fpardf

CURRENT_EQDSK = geqdsk
CURRENT_INSTATE = instate

STATE_FILES = ${CURRENT_STATE} ${CURRENT_GMTRY} ${CURRENT_RATES} ${CURRENT_PARDF} ${CURRENT_EQDSK} ${CURRENT_INSTATE}

# ======================================================================
# PORTS SECTION
# ======================================================================

[PORTS]

    NAMES = INIT DRIVER SOLVER  

    # Required ports - DRIVER and INIT   

    [[DRIVER]]
        IMPLEMENTATION = solps_driver

    [[INIT]]
        IMPLEMENTATION = solps_init
      
    # Physics ports

    [[SOLVER]]
        IMPLEMENTATION = solps_solver

    [[NEUTRAL]]
        IMPLEMENTATION = solps_eirene 

    [[BC]]
        IMPLEMENTATION = solps_constraint_separatrix

    # Monitor ports
   
    [[MONITOR]]
        IMPLEMENTATION = solps_b2plot

# ======================================================================
# COMPONENT CONFIGURATION SECTION
# ======================================================================

[solps_init]
    CLASS = solps 
    SUB_CLASS = 
    NAME = solps_init
    MODULE = solps_iter.solps_init
    SCRIPT = 
    NPROC = 1
    BIN_PATH = ${SOLPS_BIN_DIR}
    INPUT_DIR = ${INPUT_DIR_SIM}
    GRIDFILE = lsn_183244_3100.v002.geo  
    RESTART_STATE = b2fstate 
    INSTATE = # instate_input
    GEQDSK = # g183244.03100
    INPUT_FILES = b2ag.dat b2ar.dat b2ah.dat b2ai.dat ${GRIDFILE} ${RESTART_STATE} ${INSTATE} ${GEQDSK}
    OUTPUT_FILES = 
    RESTART_FILES =

[solps_driver]
    CLASS = solps
    SUB_CLASS = 
    NAME = solps_driver
    MODULE = solps_iter.solps_driver 
    SCRIPT = 
    NPROC = 1
    BIN_PATH = 
    INPUT_DIR = ${INPUT_DIR_SIM}
    INPUT_FILES = 
    OUTPUT_FILES = 
    RESTART_FILES = 

[solps_solver]
    CLASS = solps
    SUB_CLASS = 
    NAME = solps_solver
    MODULE = solps_iter.solps_solver
    NPROC = 16
    SCRIPT = 
    BIN_PATH = ${SOLPS_BIN_DIR}
    BIN = b2mn.exe 
    METHOD = solver
    EIRENE = 1
    INPUT_DIR = ${INPUT_DIR_SIM}
    PARAMETER_FILES = b2.boundary.parameters b2.neutrals.parameters b2.numerics.parameters b2.transport.parameters b2.transport.inputfile # param.dg
    EIRENE_FILES = input.dat fort.33 fort.34 fort.35
    B2MNDAT = b2mn.dat
    EPED_STATE_INPUT = 
    INPUT_FILES = ${B2MNDAT} ${PARAMETER_FILES} ${EIRENE_FILES} ${EPED_STATE_INPUT}
    OUTPUT_FILES = b2time.nc b2tallies.nc balance.nc fort.31 fort.44 b2fstate b2wdat.tar 
    RESTART_FILES = 
    CLEAN_AFTER = 1 
    STATE_FILES_ADD = # b2ftrace b2ftrack b2fplasma b2fparam b2mn.dat b2.boundary.parameters param.dg
    ARCHIVE_WDAT = enabled
    UPDATE_FLUX = disabled

[solps_eirene]
    CLASS = solps
    SUB_CLASS = 
    NAME = solps_eirene
    NPROC = 1 
    BIN_PATH = ${SOLPS_BIN_DIR}
    BIN = eirobjx
    INPUT_DIR = ${INPUT_DIR_SIM}
    INPUTDAT = input.dat
    INPUT_FILES = $INPUTDAT fort.33 fort.34 fort.35 fort.31
    OUTPUT_FILES = fort.44 
    RESTART_FILES = 
    PLASMA_STATE_FILES = fort.30
    SCRIPT = 
    MODULE = solps_iter.solps_eirene

[solps_constraint_separatrix]
    CLASS = solps 
    SUB_CLASS = 
    NAME = solps_constraint_separatrix
    MODULE = solps_iter.solps_constraint_separatrix
    SCRIPT = 
    NPROC = 1
    BIN_PATH = ${SOLPS_BIN_DIR}
    INPUT_DIR = ${INPUT_DIR_SIM}
    INPUT_FILES = 
    OUTPUT_FILES = 
    RESTART_FILES =

[solps_b2plot]
    CLASS = solps
    SUB_CLASS = 
    NAME = solps_b2plot
    NPROC = 1
    BIN_PATH = ${SOLPS_BIN_DIR}
    BIN = b2pl.exe 
    INPUT_DIR = ${INPUT_DIR_SIM}
    CMD = phys a4p mesh | te 96 writ f.y
    PLOT = mesh.ps | te_target.ps 
    DATA = | te_target.dat 
    INPUT_FILES = 
    OUTPUT_FILES = te_target.dat
    RESTART_FILES = 
    SCRIPT = 
    MODULE = solps_iter.solps_b2plot
    STATE_FILES = b2fstate b2fgmtry b2frates b2fpardf b2ftrack b2fplasma b2fparam b2mn.dat b2.boundary.parameters

[solps_monitor]
    CLASS = solps
    SUB_CLASS =
    NAME = solps_monitor
    NPROC = 1
    BIN_PATH = 
    BIN = 
    INPUT_DIR = 
    INPUT_FILES = 
    OUTPUT_FILES = 
    RESTART_FILES = 
    SCRIPT = 
    MODULE = solps_iter.solps_monitor

# =============================================================================
# ITERATION LOOP SECTION
# =============================================================================

[ITERATION_LOOP]
    MODE = REGULAR
    NSTEP = 1 # 30 
