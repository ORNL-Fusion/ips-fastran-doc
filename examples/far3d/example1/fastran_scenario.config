
# ======================================================================
# SIMULATION INFO SECTION
# ======================================================================

RUN_ID = fastran
TOKAMAK_ID = D3D
SHOT_NUMBER = 029915 
TIME_ID = 07404 

SIM_NAME = ${RUN_ID}_${TOKAMAK_ID}_${SHOT_NUMBER}

OUTPUT_PREFIX = 
LOG_FILE = run.log
LOG_LEVEL = DEBUG

INPUT_DIR_SIM = ${PWD}/input
SIM_ROOT = ${PWD}/SCAN

RUN_COMMENT = KSTAR snapshot analysis 
TAG = 

SIMULATION_MODE = NORMAL
RESTART_TIME =
RESTART_ROOT = ${SIM_ROOT}

USE_PORTAL = True
PORTAL_URL = http://lb.ipsportal.production.svc.spin.nersc.org

# ======================================================================
# PLASMA STATE SECTION
# ======================================================================

STATE_WORK_DIR = ${SIM_ROOT}/work/plasma_state

CURRENT_STATE = s${SHOT_NUMBER}.${TIME_ID}
CURRENT_EQDSK = g${SHOT_NUMBER}.${TIME_ID}
CURRENT_INSTATE = i${SHOT_NUMBER}.${TIME_ID}

STATE_FILES = ${CURRENT_STATE} ${CURRENT_EQDSK} ${CURRENT_INSTATE}

# ======================================================================
# PORTS SECTION
# ======================================================================

[PORTS]

    NAMES = INIT DRIVER EQ0 TR0 BC0 EC NB EQ BC TR
    PREPROCESS = EQ0 TR0 BC0 

    # DRIVER and INIT   

    [[DRIVER]]
        IMPLEMENTATION = fastran_driver

    [[INIT]]
        IMPLEMENTATION = fastran_init
      
    # Physics ports

    [[TR0]]
        IMPLEMENTATION = fastran0

    [[TR]]
        IMPLEMENTATION = fastran

    [[EQ0]]
        IMPLEMENTATION = efit0

    [[EQ]]
        IMPLEMENTATION = efit

    [[EC]]
        IMPLEMENTATION = toray

    [[NB]]
    #   IMPLEMENTATION = nfreya  
        IMPLEMENTATION = nubeam  

    [[BC0]]
        IMPLEMENTATION = constraint_current0
    #   IMPLEMENTATION = modeleq_constraint
    [[BC]]
        IMPLEMENTATION = constraint_current

    # Monitor ports
   
    [[MONITOR]]
        IMPLEMENTATION = monitor

# ======================================================================
# COMPONENT CONFIGURATION SECTION
# ======================================================================

[fastran_init]
    CLASS = fastran
    SUB_CLASS = init
    NAME = fastran_init
    MODULE = fastran.driver.fastran_init
    SCRIPT =
    NPROC = 1
    BIN_PATH = 
    BIN = 
    INPUT_DIR = ${INPUT_DIR_SIM}
    INIT_METHOD = instate
    INSTATE_METHOD = # model
    INSTATE = instate
    INGEQDSK = # ingeqdsk
    INPUT_FILES = ${INSTATE} ${INGEQDSK}
    OUTPUT_FILES = 
    RESTART_FILES = 

[fastran_driver]
    CLASS = fastran
    SUB_CLASS = driver
    NAME = fastran_driver
    MODULE = fastran.driver.fastran_driver
    SCRIPT =
    NPROC = 1
    BIN_PATH =
    BIN =
    INPUT_DIR = ${INPUT_DIR_SIM}
    INPUT_FILES =
    OUTPUT_FILES =
    RESTART_FILES =
    SUMMARY = ${PWD}/SUMMARY

[fastran0]
    CLASS = fastran
    SUB_CLASS = tr0
    NAME = fastran
    MODULE = fastran.solver.fastran
    SCRIPT =
    NPROC = 1
    NPROC_KY = 1
    BIN_PATH = ${FASTRAN_BIN_DIR}
    BIN = ${FASTRAN_BIN_NAME}
    INPUT_DIR = ${INPUT_DIR_SIM}
    INFASTRAN = infastran0
    INPUT_FILES = ${INFASTRAN} intglf
    OUTPUT_FILES = fastran.nc inprof inmetric infastran intglf xfastran.log ${CURRENT_INSTATE}
    RESTART_FILES =

    RELAX = 1.0

[fastran]
    CLASS = fastran
    SUB_CLASS = tr
    NAME = fastran
    MODULE = fastran.solver.fastran
    SCRIPT =
    NPROC = 1
    NPROC_KY = 1
    BIN_PATH = ${FASTRAN_BIN_DIR}
    BIN = ${FASTRAN_BIN_NAME}
    INPUT_DIR = ${INPUT_DIR_SIM}
    INFASTRAN = infastran
    INPUT_FILES = ${INFASTRAN} intglf
    OUTPUT_FILES = fastran.nc inprof inmetric infastran intglf xfastran.log ${CURRENT_INSTATE}
    RESTART_FILES =

    RELAX = 1.0

[efit0]
    CLASS = fastran
    SUB_CLASS = eq0
    NAME = efit
    MODULE = fastran.equilibrium.efit
    SCRIPT =
    NPROC = 1
    BIN_PATH = ${EFIT_BIN_DIR}
    BIN = ${EFIT_BIN_NAME} 129 129
    INPUT_DIR = ${INPUT_DIR_SIM}
    INPUT_FILES = 
    OUTPUT_FILES = g*.* a*.* m*.* k*.* efit.log 
    RESTART_FILES =

    INIT_RUN = 1
    INIT_RUN_STEP = 0
    NITER = 10
    PRESSURE = 'total'
#   PRESSURE = 'kinetic'

    TOPOLOGY = USN # LSN USN DN

[efit]
    CLASS = fastran
    SUB_CLASS = eq
    NAME = efit
    MODULE = fastran.equilibrium.efit
    SCRIPT =
    NPROC = 1
    BIN_PATH = ${EFIT_BIN_DIR}
    BIN = ${EFIT_BIN_NAME} 129 129
    INPUT_DIR = ${INPUT_DIR_SIM}
    INPUT_FILES = 
    OUTPUT_FILES = g*.* a*.* m*.* k*.* efit.log s*.*
    RESTART_FILES =

    INIT_RUN = 1 
    INIT_RUN_STEP = 0
    NITER = 10
#   PRESSURE = 'total'
    PRESSURE = 'kinetic'

    TOPOLOGY = USN # LSN USN DN

[nubeam]
    CLASS = fastran
    SUB_CLASS = nb
    NAME = nubeam
    MODULE = fastran.heating.nubeam
    SCRIPT =
    NPROC = 24
    BIN_PATH = ${NUBEAM_BIN_DIR}
    BIN = ${NUBEAM_BIN_NAME}
    PREACT = ${DATA_DIR}/nubeam/PREACT
    ADAS = ${DATA_DIR}/nubeam/ADAS
    INPUT_DIR = ${INPUT_DIR_SIM}
    INPUT_FILES = innubeam
    OUTPUT_FILES = log.nubeam* state_changes.cdf
    RESTART_FILES = *.cdf *.dat nubeam_comp_exec.RUNID
    COPY_PREACT = 0
#   FREEZE = 5
#   RESUME = -1

    LOAD_INIT_EQ = enabled
    FRANTIC_ACTION = WALL_ONLY
    UPDATE_INSTATE = enabled

[toray]
    CLASS = fastran
    SUB_CLASS = ec
    NAME = toray
    MODULE = fastran.heating.toray
    SCRIPT =
    NPROC = 1
    BIN_PATH = ${TORAY_BIN_DIR}
    BIN = ${TORAY_BIN_NAME}
    INPUT_DIR = ${INPUT_DIR_SIM}
    INPUT_FILES = intoray
    OUTPUT_FILES = toray*.nc 
    RESTART_FILES =

[constraint_current0]
    CLASS = fastran
    SUB_CLASS = pre
    NAME = constraint_current
    MODULE = fastran.constraint.constraint_current
    SCRIPT =
    NPROC = 1
    BIN_PATH =
    BIN =
    INPUT_DIR = ${INPUT_DIR_SIM}
    INPUT_FILES =
    OUTPUT_FILES =
    RESTART_FILES =

#   METHOD = broadJ
#   RHO_J = 0.4
#   JAXIS = 0.8
#   RHO_JBDRY = 0.85

    METHOD = parabolicJ
    Q0 = 1.1
    ALPHA = 1.5
    JBOOT = 1.0
    RHO_JBDRY = 0.90

[constraint_current]
    CLASS = fastran
    SUB_CLASS = tr
    NAME = constraint_current
    MODULE = fastran.constraint.constraint_current
    SCRIPT =
    NPROC = 1
    BIN_PATH =
    BIN =
    INPUT_DIR = ${INPUT_DIR_SIM}
    INPUT_FILES =
    OUTPUT_FILES =
    RESTART_FILES =

#   METHOD = broadJ
#   RHO_J = 0.6
#   JAXIS = 0.8
#   RHO_JBDRY = 0.85

    METHOD = parabolicJ
    Q0 = 1.1
    ALPHA = 1.5
    JBOOT = 1.0
    RHO_JBDRY = 0.90

[monitor]
    CLASS = monitor
    SUB_CLASS =
    NAME = monitor
    MODULE = fastran.monitor.monitor
    SCRIPT =
    NPROC = 1
    BIN_PATH =
    BIN =
    INPUT_DIR =
    INPUT_FILES =
    OUTPUT_FILES =
    RESTART_FILES =

# =============================================================================
# ITERATION LOOP SECTION
# =============================================================================

[ITERATION_LOOP]
    MODE = REGULAR
    NSTEP = 3   
    NSTEP_PREPROCESS = 3  
