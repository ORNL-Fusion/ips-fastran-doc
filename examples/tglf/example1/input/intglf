&intglf
!   NUMBER OF SPECIES INCLUDING ELECTRONS AND IONS
    tglf_ns_in = 3

!   SPECIES MASSES NORMALIZED TO MASS OF DEUTERIUM
    tglf_mass_in(1) = 2.723D-4
    tglf_mass_in(2) = 1.0
    tglf_mass_in(3) = 6.0

!   SPECIES CHARGE NUMBERS
    tglf_zs_in(1) = -1.0
    tglf_zs_in(2) = 1.0
    tglf_zs_in(3) = 6.0

!   COLLISION MODEL (2=new)
    tglf_xnu_model_in = 3

!   1.0 = USE QUENCH RULE
!   0.0 = USE NEW SPECTRAL SHIFT MODEL
    tglf_alpha_quench_in = 0.0

!   MULTIPLIES ExB VELOCITY SHEAR FOR SPECTRAL SHIFT MODEL
    tglf_alpha_e_in    = 1.0
    tglf_alpha_p_in    = 1.0
    tglf_alpha_zf_in   = 1.0
    tglf_alpha_mach_in = 0.0

!   INCLUDING TRANSVERSE MAGNETIC FLUCTUATIONS (\delta A||)
    tglf_use_bper_in = .true.

!   INCLUDING COMPRESSIONAL MAGNETIC FLUCTUATIONS (\delta B||)
    tglf_use_bpar_in = .false.

!   SATURATION RULE
    tglf_sat_rule_in = 2

!   NUMBER OF BASIS FUNCTIONS
    tglf_find_width_in = .false.
    tglf_nbasis_max_in = 6
    tglf_nbasis_min_in = 6

/
