
strategy
  single_method
  tabular_graphics_data

model
  single

interface
  fork asynchronous evaluation_concurrency = 5 file_tag, file_save
  analysis_driver = 'ips_dakota_client.py'
  parameters_file = 'params.in'
  results_file    = 'results.out'
  failure_capture = recover -1.0 -1.0

responses
  num_objective_functions = 2
  no_gradients
  no_hessians

variables
  continuous_design = 3
  descriptors
 'eped_driver__SHOT'
 'eped_driver__TIMEID'
 'eped_driver__NEPED'

method
  list_parameter_study
  list_of_points =
     1  0  3.0 
     1  1  4.0
     1  2  5.0
     1  3  6.0
     1  4  7.0
