
environment
  tabular_data
    tabular_data_file = 'dakota_ips.dat'

model
  single

interface
  fork 
  asynchronous 
  evaluation_concurrency = 1 
  analysis_driver = 'dakota_ips_driver.sh'
  parameters_file = 'params.in'
  results_file    = 'results.out'
  file_tag
  file_save

responses
  num_objective_functions = 4
  no_gradients
  no_hessians

variables
  continuous_design = 15
  descriptors
  'r' 
  'aratio' 
  'kappa' 
  'delta' 
  'bt' 
  'q95' 
  'fgw_ped' 
  'nepeak' 
  'h98' 
  'pnb' 
  'enb', 
  'prf' 
  'r_rf' 
  'rho_jpeak' 
  'jaxis'


method
  list_parameter_study
  list_of_points =
     4.0 3.0 2.0 0.6 7.0 5.5 1.0 1.8 1.3 50.0 1000.0 20 0.0 0.65 0.7
